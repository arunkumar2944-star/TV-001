# ============================================================
# Trichy Vision - frontend environment
# Copy to .env  (or .env.local).  NEVER commit real values.
#
# NOTE: everything with a VITE_ prefix is bundled into the browser build.
# Never put a secret here - AUTH_SECRET and N8N_WEBHOOK_SECRET stay on the
# server only.
# ============================================================

# Where the API lives, as seen by the BROWSER.
# Leave as /api in development: the Vite dev server proxies it to the backend,
# so the app is single-origin and the session cookie just works.
VITE_API_URL=/api

# Backend the dev-server proxy forwards /api to.
VITE_API_PROXY_TARGET=http://localhost:4000

# Dev server port
VITE_PORT=5173

# Dashboard auto refresh interval in milliseconds (0 disables polling)
VITE_DASHBOARD_REFRESH_MS=30000



