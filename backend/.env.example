# ============================================================
# Trichy Vision - backend environment
# Copy to .env and fill in real values.  NEVER commit .env.
# ============================================================

# --- Core -------------------------------------------------
NODE_ENV=development
PORT=4000

# Supabase PostgreSQL connection string (the EXISTING database).
# Supabase -> Project Settings -> Database -> Connection string -> URI
# Use the pooled (pgBouncer, port 6543) URI for serverless, or the
# direct (port 5432) URI for a long-lived office server.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Set to "false" only for a local Postgres without TLS.
DATABASE_SSL=true
# Supabase uses a certificate chain Node does not ship; keep true unless you
# provide DATABASE_CA_CERT below.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Optional: absolute path to the Supabase CA certificate (prod-hardened setup).
# DATABASE_CA_CERT=/etc/ssl/certs/supabase-ca.crt
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Authentication ---------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=CHANGE_ME_generate_a_long_random_secret
AUTH_TOKEN_TTL=8h
AUTH_COOKIE_NAME=tv_session
# Set to true when served over HTTPS (production).  Required for SameSite=None.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Leave empty unless frontend + backend share a parent domain (e.g. .trichyvision.local)
AUTH_COOKIE_DOMAIN=
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WINDOW_MS=60000

# --- Frontend / CORS --------------------------------------
# Comma separated list is supported for multiple origins.
FRONTEND_URL=http://localhost:5173

# --- Browser OAuth session --------------------------------
# Separate from AUTH_SECRET. Used only by express-session for OAuth state.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_generate_a_second_long_random_secret

# --- Meta / Facebook Pages --------------------------------
# Create one Meta app and configure the exact callback URL below in
# Facebook Login -> Valid OAuth Redirect URIs.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_CALLBACK_URL=http://localhost:4000/api/facebook/oauth/callback

# Encrypts Page access tokens at rest with AES-256-GCM. Must be exactly
# 32 bytes / 64 hex characters. Keep this stable after storing tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS

# --- n8n automation layer ---------------------------------
# The webhook n8n exposes; the API POSTs {jobId,newsId,...} here on publish.
N8N_WEBHOOK_URL=https://n8n.example.local/webhook/trichy-vision-publish
# Shared secret. Sent to n8n as X-TrichyVision-Signature (HMAC-SHA256 of the body)
# and required back from n8n on /api/n8n/* as X-N8N-Secret or an HMAC signature.
N8N_WEBHOOK_SECRET=CHANGE_ME_shared_secret_with_n8n
N8N_TIMEOUT_MS=15000
# Base URL n8n should use to call back / fetch content. Defaults to the request host.
PUBLIC_API_URL=http://localhost:4000

# --- Media storage ----------------------------------------
# local | s3   (s3 also covers MinIO and any S3-compatible object storage)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=200
MAX_UPLOAD_FILES=10

# Only used when STORAGE_DRIVER=s3 (requires the optional @aws-sdk packages)
# S3_ENDPOINT=http://minio.office.local:9000
# S3_REGION=us-east-1
# S3_BUCKET=trichy-vision-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_SIGNED_URL_TTL=900

# --- Logging ----------------------------------------------
LOG_LEVEL=info

# --- Tests ------------------------------------------------
# Integration tests are SKIPPED unless this points at a disposable database.
# NEVER point this at the production Supabase database.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trichy_vision_test
